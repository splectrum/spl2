{
  "type": "record",
  "name": "InfoInput",
  "namespace": "spl.console",
  "doc": "Log an informational message",
  "fields": [
    {
      "name": "message",
      "type": "string",
      "doc": "Info message to log"
    },
    {
      "name": "format",
      "type": "string",
      "default": "text",
      "doc": "Output format: text or json"
    },
    {
      "name": "data",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional additional data (JSON string)"
    }
  ]
}
