{
  "type": "record",
  "name": "ConfigureOutput",
  "namespace": "spl.console",
  "doc": "Configure method output - result or error",
  "fields": [
    {
      "name": "value",
      "type": [
        {
          "type": "record",
          "name": "ConfigureResult",
          "doc": "Successful configuration result",
          "fields": [
            {
              "name": "configured",
              "type": "boolean",
              "doc": "Configuration was applied successfully"
            },
            {
              "name": "level",
              "type": "string",
              "doc": "Active log level"
            },
            {
              "name": "format",
              "type": "string",
              "doc": "Active output format"
            },
            {
              "name": "destination",
              "type": "string",
              "doc": "Active output destination"
            }
          ]
        },
        {
          "type": "record",
          "name": "Error",
          "doc": "Error result",
          "fields": [
            {
              "name": "code",
              "type": "string",
              "doc": "Error code for programmatic handling"
            },
            {
              "name": "message",
              "type": "string",
              "doc": "Human readable error description"
            }
          ]
        }
      ],
      "doc": "Result value - either success or error"
    }
  ]
}
