{
  "type": "record",
  "name": "ConfigureInput",
  "namespace": "spl.console",
  "doc": "Configure console settings for logging output",
  "fields": [
    {
      "name": "level",
      "type": "string",
      "default": "info",
      "doc": "Log level threshold: debug, info, warn, error. Messages below this level are filtered."
    },
    {
      "name": "format",
      "type": "string",
      "default": "text",
      "doc": "Output format: text (human readable) or json (structured)"
    },
    {
      "name": "destination",
      "type": "string",
      "default": "stdout",
      "doc": "Output destination: stdout, stderr, or file path"
    }
  ]
}
