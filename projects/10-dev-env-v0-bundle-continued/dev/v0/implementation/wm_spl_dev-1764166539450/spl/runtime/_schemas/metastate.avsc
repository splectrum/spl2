{
  "type": "record",
  "name": "RuntimeMetastate",
  "namespace": "spl.runtime",
  "doc": "Public runtime context properties shared via headers",
  "fields": [
    {
      "name": "cwd",
      "type": "string",
      "doc": "Bundle root directory - base path for relative resolution"
    },
    {
      "name": "splectrumDir",
      "type": "string",
      "doc": "Splectrum installation directory"
    },
    {
      "name": "invokedFrom",
      "type": "string",
      "doc": "Directory from which the spl command was invoked"
    }
  ]
}
