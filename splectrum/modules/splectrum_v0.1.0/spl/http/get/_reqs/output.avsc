{
  "type": "record",
  "name": "spl.http.get.output",
  "doc": "HTTP response output",
  "fields": [
    {
      "name": "ok",
      "type": "boolean",
      "doc": "True if request succeeded (no network error)"
    },
    {
      "name": "status",
      "type": ["null", "int"],
      "default": null,
      "doc": "HTTP status code"
    },
    {
      "name": "statusText",
      "type": ["null", "string"],
      "default": null,
      "doc": "HTTP status message"
    },
    {
      "name": "headers",
      "type": ["null", {"type": "map", "values": "string"}],
      "default": null,
      "doc": "Response headers"
    },
    {
      "name": "body",
      "type": ["null", "string"],
      "default": null,
      "doc": "Response body as text"
    },
    {
      "name": "error",
      "type": ["null", "string"],
      "default": null,
      "doc": "Error message if request failed"
    }
  ]
}
