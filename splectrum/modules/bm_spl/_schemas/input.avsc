{
  "type": "record",
  "name": "branch.input",
  "doc": "Branch node input - adds batch capability",
  "fields": [
    {
      "name": "batch",
      "type": ["null", {
        "type": "array",
        "items": {
          "type": "record",
          "name": "invocation",
          "fields": [
            { "name": "target", "type": "string", "doc": "Target path within scope" },
            { "name": "input", "type": ["null", "string"], "default": null, "doc": "Input payload (JSON string)" }
          ]
        }
      }],
      "default": null,
      "doc": "Array of invocations to execute within scope"
    }
  ]
}
