{
  "type": "record",
  "name": "spl.crud.lift.input",
  "doc": "Lift method input",
  "fields": [
    {
      "name": "resource",
      "type": ["null", "string"],
      "default": null,
      "doc": "Single resource to lift (e.g., index.js, _lib/foo.js)"
    },
    {
      "name": "modules",
      "type": "boolean",
      "default": false,
      "doc": "Lift container from lower module layer (bm_spl → work_module)"
    },
    {
      "name": "recursive",
      "type": "boolean",
      "default": false,
      "doc": "With --modules: lift full hive (all descendant containers)"
    },
    {
      "name": "all",
      "type": "boolean",
      "default": false,
      "doc": "Lift all resources (future - creates standalone container)"
    },
    {
      "name": "dryRun",
      "type": "boolean",
      "default": false,
      "doc": "Preview only, no action taken"
    },
    {
      "name": "silent",
      "type": "boolean",
      "default": false,
      "doc": "Omit narrative, data only"
    },
    {
      "name": "help",
      "type": "boolean",
      "default": false,
      "doc": "Show usage information"
    }
  ]
}
