{
  "type": "record",
  "name": "spl.wrapper.input",
  "doc": "Wrapper input with passthrough args and splectrum control flags",
  "fields": [
    {
      "name": "dryRun",
      "type": "boolean",
      "default": false,
      "doc": "Preview only, no action taken"
    },
    {
      "name": "silent",
      "type": "boolean",
      "default": false,
      "doc": "Omit narrative, data only"
    },
    {
      "name": "help",
      "type": "boolean",
      "default": false,
      "doc": "Show usage information"
    },
    {
      "name": "args",
      "type": ["null", "string"],
      "default": null,
      "doc": "Passthrough arguments for wrapped tool (quoted, ready for shell)"
    },
    {
      "name": "base64",
      "type": ["null", "string"],
      "default": null,
      "doc": "Base64-encoded args (alternative to --args, bypasses shell escaping)"
    }
  ]
}
