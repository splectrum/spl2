{
  "type": "record",
  "name": "spl.introspection.selfeval.input",
  "doc": "Selfeval validation input",
  "fields": [
    {
      "name": "dryRun",
      "type": "boolean",
      "default": false,
      "doc": "Preview only, no action taken"
    },
    {
      "name": "silent",
      "type": "boolean",
      "default": false,
      "doc": "Omit narrative, data only"
    },
    {
      "name": "help",
      "type": "boolean",
      "default": false,
      "doc": "Show usage information"
    },
    {
      "name": "meta",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "MetaLevel",
          "symbols": [
            "topline",
            "summary",
            "detail",
            "enriched",
            "report"
          ]
        }
      ],
      "default": null,
      "doc": "Freetext output level (default: summary)"
    },
    {
      "name": "report",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "ReportLevel",
          "symbols": [
            "topline",
            "summary",
            "detail",
            "enriched"
          ]
        }
      ],
      "default": null,
      "doc": "Structured output level (default: none)"
    },
    {
      "name": "levels",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Which levels to validate: all (default), or comma-separated type names"
    },
    {
      "name": "runner",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Filter runners: comma-separated runner names (default: all)"
    },
    {
      "name": "failFast",
      "type": "boolean",
      "default": false,
      "doc": "Stop on first failure"
    }
  ]
}
