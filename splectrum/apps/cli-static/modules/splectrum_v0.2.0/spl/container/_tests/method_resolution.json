{
  "name": "method resolution",
  "category": "introspection",
  "tests": [
    {
      "name": "whoami shows container identity",
      "runner": "command",
      "command": "/whoami",
      "expect": {
        "contains": "spl/container [levels:"
      }
    },
    {
      "name": "whoami --levels=all shows full type chain",
      "runner": "command",
      "command": "/whoami --levels=all",
      "expect": {
        "contains": ["spl/container [1]", "spl/api [4]"]
      }
    }
  ]
}
