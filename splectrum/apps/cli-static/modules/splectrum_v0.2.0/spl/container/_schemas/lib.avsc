{
  "type": "record",
  "name": "spl.container.lib",
  "doc": "Lib facet - _lib/index.json structure",
  "fields": [
    {
      "name": "name",
      "type": "string",
      "doc": "Facet name (e.g., lib)"
    },
    {
      "name": "purpose",
      "type": "string",
      "doc": "Description of what this lib collection provides"
    },
    {
      "name": "files",
      "type": {
        "type": "map",
        "values": {
          "type": "record",
          "name": "LibFile",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "doc": "Short name for the lib"
            },
            {
              "name": "description",
              "type": "string",
              "doc": "What this lib does"
            },
            {
              "name": "exports",
              "type": {
                "type": "array",
                "items": "string"
              },
              "doc": "Exported function names"
            }
          ]
        }
      },
      "doc": "Map of filename to lib metadata"
    }
  ]
}
