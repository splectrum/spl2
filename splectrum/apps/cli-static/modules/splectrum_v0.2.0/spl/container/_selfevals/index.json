{
  "name": "selfevals",
  "purpose": "Container self-evaluation registry",
  "runners": {
    "lib": {
      "name": "lib",
      "description": "Check lib exports match manifest",
      "file": "selfeval_lib.js"
    },
    "schemas": {
      "name": "schemas",
      "description": "Check schema files match manifest",
      "file": "selfeval_schemas.js"
    },
    "handler": {
      "name": "handler",
      "description": "Check handler index.js exists",
      "file": "selfeval_handler.js"
    },
    "reqs": {
      "name": "reqs",
      "description": "Check req files match manifest",
      "file": "selfeval_reqs.js"
    },
    "final": {
      "name": "final",
      "description": "Check final resources don't overlap across type chain",
      "file": "selfeval_final.js"
    },
    "schemas_inheritance": {
      "name": "schemas_inheritance",
      "description": "Check schema files include inherited parent fields",
      "file": "selfeval_schemas_inheritance.js"
    },
    "container": {
      "name": "container",
      "description": "Check container facet (required fields, no extras, valid instantiates)",
      "file": "selfeval_container.js"
    },
    "schemas_data": {
      "name": "schemas_data",
      "description": "Validate facet data files against their .avsc schemas",
      "file": "selfeval_schemas_data.js"
    },
    "tests": {
      "name": "tests",
      "description": "Execute data-driven tests from _tests/ folder",
      "file": "selfeval_tests.js"
    }
  }
}
