{
  "type": "record",
  "name": "spl.container.reqs",
  "doc": "Reqs facet - _reqs/index.json structure",
  "fields": [
    {
      "name": "name",
      "type": "string",
      "doc": "Facet name (e.g., reqs)"
    },
    {
      "name": "purpose",
      "type": "string",
      "doc": "Description of what requirements this collection defines"
    },
    {
      "name": "requirements",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "Requirement",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "doc": "Requirement identifier"
            },
            {
              "name": "description",
              "type": "string",
              "doc": "What this requirement specifies"
            },
            {
              "name": "file",
              "type": "string",
              "doc": "Filename of the requirement document"
            }
          ]
        }
      },
      "doc": "Array of requirement entries"
    }
  ]
}
