{
  "type": "record",
  "name": "spl.container.selfevals",
  "doc": "Selfevals facet - _selfevals/index.json structure",
  "fields": [
    {
      "name": "name",
      "type": "string",
      "doc": "Facet name (e.g., selfevals)"
    },
    {
      "name": "purpose",
      "type": "string",
      "doc": "Description of what this selfeval collection validates"
    },
    {
      "name": "runners",
      "type": {
        "type": "map",
        "values": {
          "type": "record",
          "name": "Runner",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "doc": "Runner identifier"
            },
            {
              "name": "description",
              "type": "string",
              "doc": "What this runner validates"
            },
            {
              "name": "file",
              "type": "string",
              "doc": "Filename of the runner implementation"
            }
          ]
        }
      },
      "doc": "Map of runner name to runner metadata (run for all instances)"
    },
    {
      "name": "instanceRunners",
      "type": ["null", {
        "type": "map",
        "values": {
          "type": "record",
          "name": "InstanceRunner",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "doc": "Runner identifier"
            },
            {
              "name": "description",
              "type": "string",
              "doc": "What this runner validates"
            },
            {
              "name": "file",
              "type": "string",
              "doc": "Filename of the runner implementation"
            }
          ]
        }
      }],
      "default": null,
      "doc": "Map of runner name to runner metadata (run only for direct instances)"
    }
  ]
}
