{
  "type": "record",
  "name": "spl.container.container",
  "doc": "Container facet - index.json structure",
  "fields": [
    {
      "name": "name",
      "type": "string",
      "doc": "Container path (e.g., spl/container/whoami)"
    },
    {
      "name": "instantiates",
      "type": "string",
      "doc": "Type this container is an instance of"
    },
    {
      "name": "extends",
      "type": ["null", "string"],
      "default": null,
      "doc": "Parent type path for inheritance chain, or null"
    },
    {
      "name": "type",
      "type": ["null", {
        "type": "record",
        "name": "TypeDefinition",
        "doc": "Type-level definitions (only for containers that are types)",
        "fields": [
          {
            "name": "children",
            "type": ["null", {
              "type": "record",
              "name": "TypeChildren",
              "doc": "Children definition for instances of this type",
              "fields": [
                {
                  "name": "type",
                  "type": "string",
                  "doc": "Type that children instantiate"
                }
              ]
            }],
            "default": null
          }
        ]
      }],
      "default": null
    },
    {
      "name": "instance",
      "type": ["null", {
        "type": "record",
        "name": "InstanceDefinition",
        "doc": "Instance-level definitions (only for containers with children)",
        "fields": [
          {
            "name": "children",
            "type": ["null", {
              "type": "record",
              "name": "InstanceChildren",
              "doc": "This container's children",
              "fields": [
                {
                  "name": "type",
                  "type": "string",
                  "doc": "Type that children instantiate"
                },
                {
                  "name": "list",
                  "type": {"type": "array", "items": "string"},
                  "doc": "Allowed child names"
                }
              ]
            }],
            "default": null
          }
        ]
      }],
      "default": null
    }
  ]
}
