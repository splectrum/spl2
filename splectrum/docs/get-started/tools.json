{
  "title": "Tools",
  "description": "Use splectrum tool wrappers instead of raw commands. Enables auditing and consistency.",
  "sections": [
    {
      "name": "Principle",
      "description": "Always use spl tools/X instead of raw X. Splectrum wrappers pass through to the underlying tool but enable auditing, logging, and platform integration."
    },
    {
      "name": "Base64 Encoding",
      "description": "Use base64= prefix to bypass shell escaping for special characters (!, quotes, etc.).",
      "commands": [
        { "command": "spl tools/git base64=Y29tbWl0IC1tICJIZWxsbyEi", "description": "Decodes to: commit -m \"Hello!\"" }
      ]
    },
    {
      "name": "Git",
      "commands": [
        { "command": "spl tools/git status", "description": "Not: git status" },
        { "command": "spl tools/git add -A", "description": "Not: git add -A" },
        { "command": "spl tools/git commit -m \"msg\"", "description": "Not: git commit" },
        { "command": "spl tools/git push", "description": "Not: git push" },
        { "command": "spl tools/git log --oneline -5", "description": "Not: git log" }
      ]
    },
    {
      "name": "Archive",
      "commands": [
        { "command": "spl tools/7zip a archive.7z files", "description": "Not: 7z a" },
        { "command": "spl tools/7zip x archive.7z", "description": "Not: 7z x" }
      ]
    },
    {
      "name": "Docker",
      "commands": [
        { "command": "spl tools/docker ps", "description": "Not: docker ps" },
        { "command": "spl tools/docker build -t app .", "description": "Not: docker build" },
        { "command": "spl tools/docker run -d nginx", "description": "Not: docker run" }
      ]
    },
    {
      "name": "GitHub CLI",
      "commands": [
        { "command": "spl tools/gh pr list", "description": "Not: gh pr list" },
        { "command": "spl tools/gh issue create --title \"Bug\"", "description": "Not: gh issue create" },
        { "command": "spl tools/gh repo view", "description": "Not: gh repo view" }
      ]
    },
    {
      "name": "SSH",
      "commands": [
        { "command": "spl tools/ssh user@host", "description": "Not: ssh user@host" },
        { "command": "spl tools/ssh user@host \"ls -la\"", "description": "Not: ssh user@host \"ls\"" }
      ]
    },
    {
      "name": "Rsync",
      "commands": [
        { "command": "spl tools/rsync -avz src/ dest/", "description": "Not: rsync -avz" },
        { "command": "spl tools/rsync -avz src/ user@host:dest/", "description": "Not: rsync to remote" }
      ]
    },
    {
      "name": "FFmpeg",
      "commands": [
        { "command": "spl tools/ffmpeg -i in.mp4 out.webm", "description": "Not: ffmpeg -i" },
        { "command": "spl tools/ffmpeg -i video.mp4 -vn audio.mp3", "description": "Extract audio" }
      ]
    },
    {
      "name": "Pear",
      "commands": [
        { "command": "spl tools/pear run pear://app", "description": "Not: pear run" },
        { "command": "spl tools/pear dev .", "description": "Not: pear dev" },
        { "command": "spl tools/pear stage myapp", "description": "Not: pear stage" }
      ]
    }
  ]
}
